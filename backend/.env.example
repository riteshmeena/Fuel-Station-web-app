DATABASE_URL="postgresql://fuel:fuel@localhost:5432/fuelstation?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"
PORT=4000
CORS_ORIGINS="*"
# Optional, free: comma-separated OAuth client IDs (iOS / web) for Google sign-in
GOOGLE_CLIENT_IDS=""
# First super admin (created by `npm run db:seed`)
SUPERADMIN_NAME="Station Owner"
SUPERADMIN_PHONE="9000000001"
SUPERADMIN_PIN="1234"
SEED_DEMO=false
